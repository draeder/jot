{
  "name": "jot",
  "version": "1.0.0",
  "description": "Jot: visual notes on an infinite canvas, kept and shared on the PeerPigeon mesh",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:lan": "JOT_LAN=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && npx wrangler@4 deploy",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "author": "Daniel Raeder",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/vue-3": "^3.35.0",
    "freertc": "github:draeder/freertc#1ee7970",
    "lowlight": "^3.3.0",
    "peerpigeon": "https://codeload.github.com/PeerPigeon/PeerPigeon/tar.gz/97982c65ffe07ad48b4f753c0ae247635b7dabd3",
    "pigeonidp": "https://codeload.github.com/PeerPigeon/PigeonIdP/tar.gz/0932fe78bca815ace06aa5d7f39f8013c41fe126",
    "unsea": "https://codeload.github.com/draeder/unsea/tar.gz/3fff047dfb151838fc92a5d403de9351814aa9e0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.1.0"
  }
}
