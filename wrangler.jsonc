// jot on Cloudflare: the app only (static, dist/). There is no server of its own: notes live on the
// PeerPigeon mesh's storage servers (PigeonFS), sealed with each workspace's secret, and the relays are
// freertc's. Deploy with `npm run deploy` (builds, then uploads dist/).
{
  "name": "jot",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // jot.ooo, as a custom domain of the Worker (as the Next.js jot had it).
  "routes": [{ "pattern": "jot.ooo", "custom_domain": true }]
}
